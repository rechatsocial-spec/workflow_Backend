NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/work_management
# REQUIRED in production: long random string (e.g. `openssl rand -hex 48`)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN_HOURS=12
CLIENT_URL=http://localhost:5173
# set true when served over HTTPS
COOKIE_SECURE=false
# company timezone used for "day" boundaries, reports and cron (IANA name)
APP_TIMEZONE=Asia/Kolkata

DAILY_TARGET_HOURS=8
UPDATE_INTERVAL_MINUTES=120
UPDATE_GRACE_MINUTES=15
# 0 disables break reminder; otherwise remind after N minutes of continuous work
BREAK_REMINDER_MINUTES=0
DEADLINE_WARNING_HOURS=24

# First admin (created on boot if no admin exists)
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@company.com
ADMIN_PASSWORD=ChangeMe@12345

# Optional SMTP (if empty, emails are printed to server log)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Work Management <no-reply@company.com>"
